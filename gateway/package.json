{
  "name": "wp-mcp-gateway",
  "version": "2.0.0",
  "description": "Multi-site MCP gateway for WordPress (Streamable HTTP, OAuth 2.1, API keys)",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "bin": { "wp-mcp": "dist/index.js" },
  "scripts": {
    "sync-spec": "node ../scripts/sync-spec.mjs",
    "build": "node ../scripts/sync-spec.mjs && tsc -p tsconfig.json && node ../scripts/copy-agent.mjs && npm --prefix ../panel run build",
    "build:server": "node ../scripts/sync-spec.mjs && tsc -p tsconfig.json && node ../scripts/copy-agent.mjs",
    "start": "node dist/index.js",
    "dev": "node ../scripts/sync-spec.mjs && node --experimental-strip-types src/index.ts",
    "test": "node ../scripts/sync-spec.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}

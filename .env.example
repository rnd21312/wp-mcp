# The public https address clients use (no trailing slash). Required in production.
WPMCP_PUBLIC_URL=https://mcp.example.com
# Set to 1 when a reverse proxy sets X-Forwarded-For.
WPMCP_TRUST_PROXY=1
# Optional: create the owner at start-up (12+ characters) instead of using the setup token.
# WPMCP_ADMIN_PASSWORD=
# Optional: 32 bytes as 64 hex characters. Default: generated in the data volume (data/master.key).
# WPMCP_MASTER_KEY=
